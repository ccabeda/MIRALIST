# Copiá este archivo como .env.local, completá el token y reiniciá npm run dev.
# TMDB: Ajustes de tu cuenta > API > API Read Access Token.
# Solo lo lee el servidor local. No usar el prefijo VITE_ para esta credencial.
TMDB_READ_TOKEN=

# MyAnimeList: https://myanimelist.net/apiconfig > Create ID.
# Solo necesitamos el Client ID para consultar el catálogo público.
MAL_CLIENT_ID=

# AnimeSchedule: Settings > API > Create Application. Solo servidor.
ANIMESCHEDULE_TOKEN=
